---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import CardAstro from "@/components/_examples/Card.astro"
import CardVue from "@/components/_examples/Card.vue"
import CardSvelte from "@/components/_examples/Card.svelte"
import CardReact from "@/components/_examples/Card.tsx"
---

<Layout>
  <div class="flex min-h-svh p-6">
    <div
      class="mx-auto flex max-w-7xl min-w-0 flex-col gap-4 text-sm leading-loose"
    >
      <CardReact />
      <CardSvelte />
      <CardVue />
      <CardAstro />
    </div>
  </div>
</Layout>
