---
import "../styles/global.css";
import CardAstro from "../components/_examples/Card.astro";
import CardReact from "../components/_examples/Card.tsx";
import CardSvelte from "../components/_examples/Card.svelte";
import CardVue from "../components/_examples/Card.vue";

import sourceAstro from "../components/_examples/ Card.astro?raw";
import sourceReact from "../components/_examples/Card.tsx?raw";
import sourceSvelte from "../components/_examples/Card.svelte?raw";
import sourceVue from "../components/_examples/Card.vue?raw";
import Agentation from "../components/_utility/Agentation.tsx";

const panels = [
  {
    label: "Astro",
    sub: ".astro — static-first",
    accent: "from-amber-400/90 to-amber-600/40",
  },
  {
    label: "React",
    sub: ".tsx — island",
    accent: "from-teal-400/90 to-teal-700/40",
  },
  {
    label: "Svelte",
    sub: ".svelte — island",
    accent: "from-amber-300/80 to-teal-500/35",
  },
  {
    label: "Vue",
    sub: ".vue — island",
    accent: "from-teal-300/80 to-amber-500/35",
  },
] as const;

const codeBlocks = [
  {
    label: "Card.astro",
    filename: "src/components/Card.astro",
    body: sourceAstro,
  },
  { label: "Card.tsx", filename: "src/components/Card.tsx", body: sourceReact },
  {
    label: "Card.svelte",
    filename: "src/components/Card.svelte",
    body: sourceSvelte,
  },
  { label: "Card.vue", filename: "src/components/Card.vue", body: sourceVue },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Multi-framework cards · Astro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-zinc-950 text-zinc-100 antialiased selection:bg-amber-500/30 selection:text-amber-50"
  >
    <div
      class="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(245,158,11,0.12),transparent),radial-gradient(ellipse_60%_40%_at_100%_0%,rgba(45,212,191,0.08),transparent)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none fixed inset-0 opacity-[0.035] mix-blend-overlay [background-image:url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E')]"
      aria-hidden="true"
    >
    </div>

    <main class="relative mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <header class="mb-14 max-w-2xl md:mb-20">
        <p
          class="font-display text-sm font-medium uppercase tracking-[0.35em] text-amber-400/90 md:text-base"
        >
          Islands lab
        </p>
        <h1
          class="font-display mt-4 text-4xl font-semibold leading-[1.08] text-zinc-50 md:text-5xl"
        >
          One card, four renderers
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400 md:text-xl">
          Astro hosts React, Svelte, and Vue together. The first grid shows the
          live card; the second shows the source for each implementation—same
          markup intent, framework-native syntax.
        </p>
      </header>

      <h2
        class="font-display mb-8 text-2xl font-semibold text-zinc-100 md:mb-10 md:text-3xl"
      >
        Live components
      </h2>
      <div
        class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-14"
      >
        <section class="flex flex-col gap-4">
          <div
            class="flex items-end justify-between gap-4 border-b border-zinc-800/80 pb-3"
          >
            <div>
              <h2 class="font-display text-xl font-semibold text-zinc-100">
                {panels[0].label}
              </h2>
              <p class="mt-1 text-xs uppercase tracking-widest text-zinc-500">
                {panels[0].sub}
              </p>
            </div>
            <span
              class={`h-2 w-2 shrink-0 rounded-full bg-linear-to-br ${panels[0].accent} shadow-[0_0_20px_rgba(251,191,36,0.35)]`}
              aria-hidden="true"></span>
          </div>
          <CardAstro />
        </section>

        <section class="flex flex-col gap-4">
          <div
            class="flex items-end justify-between gap-4 border-b border-zinc-800/80 pb-3"
          >
            <div>
              <h2 class="font-display text-xl font-semibold text-zinc-100">
                {panels[1].label}
              </h2>
              <p class="mt-1 text-xs uppercase tracking-widest text-zinc-500">
                {panels[1].sub}
              </p>
            </div>
            <span
              class={`h-2 w-2 shrink-0 rounded-full bg-linear-to-br ${panels[1].accent} shadow-[0_0_20px_rgba(45,212,191,0.35)]`}
              aria-hidden="true"></span>
          </div>
          <CardReact />
        </section>

        <section class="flex flex-col gap-4">
          <div
            class="flex items-end justify-between gap-4 border-b border-zinc-800/80 pb-3"
          >
            <div>
              <h2 class="font-display text-xl font-semibold text-zinc-100">
                {panels[2].label}
              </h2>
              <p class="mt-1 text-xs uppercase tracking-widest text-zinc-500">
                {panels[2].sub}
              </p>
            </div>
            <span
              class={`h-2 w-2 shrink-0 rounded-full bg-linear-to-br ${panels[2].accent} shadow-[0_0_18px_rgba(251,191,36,0.25)]`}
              aria-hidden="true"></span>
          </div>
          <CardSvelte />
        </section>

        <section class="flex flex-col gap-4">
          <div
            class="flex items-end justify-between gap-4 border-b border-zinc-800/80 pb-3"
          >
            <div>
              <h2 class="font-display text-xl font-semibold text-zinc-100">
                {panels[3].label}
              </h2>
              <p class="mt-1 text-xs uppercase tracking-widest text-zinc-500">
                {panels[3].sub}
              </p>
            </div>
            <span
              class={`h-2 w-2 shrink-0 rounded-full bg-linear-to-br ${panels[3].accent} shadow-[0_0_18px_rgba(45,212,191,0.25)]`}
              aria-hidden="true"></span>
          </div>
          <CardVue />
        </section>
      </div>

      <h2
        class="font-display mb-8 mt-20 border-t border-zinc-800/80 pt-20 text-2xl font-semibold text-zinc-100 md:mb-10 md:mt-28 md:pt-28 md:text-3xl"
      >
        Source
      </h2>
      <div
        class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-x-10 md:gap-y-10"
      >
        {
          codeBlocks.map((block) => (
            <figure class="flex flex-col gap-3">
              <figcaption class="flex flex-wrap items-baseline justify-between gap-2 border-b border-zinc-800/80 pb-2">
                <span class="font-display text-lg font-medium text-zinc-100">
                  {block.label}
                </span>
                <span class="font-mono text-[11px] text-zinc-500">
                  {block.filename}
                </span>
              </figcaption>
              <pre
                class="max-h-[min(420px,55vh)] overflow-auto rounded-xl border border-zinc-800/90 bg-zinc-950/80 p-4 text-[11px] leading-relaxed text-zinc-300 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] ring-1 ring-zinc-800/40 font-['IBM_Plex_Mono',ui-monospace,monospace]"
                tabindex="0"
              >
                <code>{block.body}</code>
              </pre>
            </figure>
          ))
        }
      </div>
    </main>

    <Agentation client:only="react" />
  </body>
</html>
